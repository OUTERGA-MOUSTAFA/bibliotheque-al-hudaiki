APP_NAME="Bibliothèque Al Hudaiki"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Frontend Next.js (plusieurs origines séparées par des virgules)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# PostgreSQL Neon : copier les valeurs depuis Neon > Connection details
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

# database : cache partagé entre conteneurs (limites de connexion, verrou du planificateur)
CACHE_STORE=database
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
# Railway : un 2e service avec ROLE=scheduler lance les rappels de retard (php artisan schedule:work)
# ROLE=web
FILESYSTEM_DISK=local

# Cloudinary : Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── E-mails ──────────────────────────────────────────────────────────────
# En local : MAIL_MAILER=log (les e-mails vont dans storage/logs/laravel.log)
# Vérifier la configuration : php artisan mail:test vous@exemple.com
#
# Option A — Brevo par API (conseillé, utilisé en production) :
#   gratuit jusqu'à 300 e-mails/jour, pas besoin de nom de domaine.
#   1. Brevo → Expéditeurs et IP → Expéditeurs : ajouter et vérifier l'adresse MAIL_FROM_ADDRESS
#   2. Brevo → SMTP & API → Clés API : créer une clé (xkeysib-…)
#   Passe par HTTPS : fonctionne sur Railway, qui bloque les ports SMTP.
MAIL_MAILER=log
BREVO_API_KEY=
#
# Option B — Resend (API HTTPS) : nécessite un nom de domaine vérifié chez Resend,
#   sinon Resend n'envoie qu'à l'adresse du propriétaire du compte.
# MAIL_MAILER=resend
RESEND_KEY=
# Pas de webhook Resend utilisé : on n'expose pas la route /resend/webhook
RESEND_ROUTES=false
#
# Option C — SMTP (Gmail avec « mot de passe d'application »…) :
#   ne fonctionne pas sur Railway (ports SMTP sortants bloqués).
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=adresse@gmail.com
# MAIL_PASSWORD="mot de passe d'application (16 lettres)"
#
# Doit être l'adresse vérifiée chez Brevo (sinon l'envoi est refusé)
MAIL_FROM_ADDRESS="noreply@alhudaiki.ma"
MAIL_FROM_NAME="${APP_NAME}"
# Formulaire de contact : refuser les domaines sans serveur de messagerie (DNS MX)
MAIL_VERIFY_DNS=true
ADMIN_EMAIL=outergamoustafa@gmail.com
