APP_NAME="Bibliothèque Al Hudaiki"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Frontend Next.js (plusieurs origines séparées par des virgules)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# PostgreSQL Neon : copier les valeurs depuis Neon > Connection details
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Cloudinary : Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mails : "log" en local, "resend" en production
MAIL_MAILER=log
RESEND_KEY=
MAIL_FROM_ADDRESS="noreply@alhudaiki.ma"
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL=outergamoustafa@gmail.com
